generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum SourceName {
  REMOTEOK
  GREENHOUSE
  LEVER
  CAREER_PAGE
}

enum RequirementType {
  REQUIRED
  NICE_TO_HAVE
}

enum ApplicationStage {
  SAVED
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  REJECTED
}

enum Proficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum Seniority {
  JUNIOR
  MID
  SENIOR
  LEAD
  STAFF
}

enum RoleCategory {
  BACKEND
  FRONTEND
  FULLSTACK
  DEVOPS
  DATA
  MOBILE
  AI_ML
  OTHER
}

enum ExtractionStatus {
  PENDING
  PROCESSED
  FAILED
}

model Company {
  id            String   @id @default(cuid())
  name          String   @unique
  careerPageUrl String?
  createdAt     DateTime @default(now())

  postings Posting[]
}

model Posting {
  id               String           @id @default(cuid())
  companyId        String
  title            String
  location         String?
  sourceUrl        String
  sourceName       SourceName
  postedAt         DateTime?
  rawTextHash      String
  createdAt        DateTime         @default(now())
  seniority        Seniority?
  yearsExperience  Int?
  roleCategory     RoleCategory?
  extractionStatus ExtractionStatus @default(PENDING)
  // 384-dim all-MiniLM-L6-v2 embedding. Unsupported() means the Prisma Client can't
  // read or write this field at all — every access goes through $queryRaw/$executeRaw
  // (see src/services/postingVectorSearch.ts and embeddingWorker.ts).
  embedding        Unsupported("vector(384)")?

  company       Company        @relation(fields: [companyId], references: [id])
  postingRaws   PostingRaw[]
  postingSkills PostingSkill[]
  applications  Application[]
  chunks        PostingChunk[]

  @@index([rawTextHash])
  @@index([companyId])
  @@index([postedAt])
  @@index([roleCategory, postedAt])
}

// Chunked posting text for RAG retrieval (src/routes/ask.ts) — separate from
// Posting.embedding, which stays a single whole-posting vector used only by
// findSimilarPostings / /api/postings/recommended (retrieval-only matching).
model PostingChunk {
  id         String   @id @default(cuid())
  postingId  String
  chunkIndex Int
  text       String
  createdAt  DateTime @default(now())
  embedding  Unsupported("vector(384)")?

  posting Posting @relation(fields: [postingId], references: [id], onDelete: Cascade)

  @@unique([postingId, chunkIndex])
  @@index([postingId])
}

// A curated reference-document corpus (see /knowledge-base), chunked and embedded
// the same way as postings, so /api/ask can retrieve from either source.
model KnowledgeDocument {
  id        String   @id @default(cuid())
  title     String
  sourceRef String   // relative path of the source markdown file, for re-ingestion / traceability
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chunks DocumentChunk[]

  @@unique([sourceRef])
}

model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  chunkIndex Int
  text       String
  createdAt  DateTime @default(now())
  embedding  Unsupported("vector(384)")?

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId])
}

model PostingRaw {
  id            String   @id @default(cuid())
  postingId     String
  rawText       String
  extractionRaw Json?
  createdAt     DateTime @default(now())

  posting Posting @relation(fields: [postingId], references: [id])

  @@index([postingId])
}

model Skill {
  id       String  @id @default(cuid())
  name     String  @unique
  category String?

  postingSkills     PostingSkill[]
  userSkillProfiles UserSkillProfile[]
}

model PostingSkill {
  id              String          @id @default(cuid())
  postingId       String
  skillId         String
  requirementType RequirementType
  createdAt       DateTime        @default(now())

  posting Posting @relation(fields: [postingId], references: [id])
  skill   Skill   @relation(fields: [skillId], references: [id])

  @@unique([postingId, skillId])
  @@index([skillId])
  @@index([postingId])
}

model Application {
  id        String           @id @default(cuid())
  postingId String
  stage     ApplicationStage @default(SAVED)
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  posting      Posting                   @relation(fields: [postingId], references: [id])
  stageHistory ApplicationStageHistory[]

  @@unique([postingId])
  @@index([stage])
}

model ApplicationStageHistory {
  id            String           @id @default(cuid())
  applicationId String
  stage         ApplicationStage
  changedAt     DateTime         @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([applicationId, changedAt])
}

model UserSkillProfile {
  id          String      @id @default(cuid())
  skillId     String
  proficiency Proficiency
  createdAt   DateTime    @default(now())

  skill Skill @relation(fields: [skillId], references: [id])

  @@index([skillId])
}

// Single-tenant app (no User model) — this is a singleton row holding the one
// profile's target role and its embedding, mirroring UserSkillProfile's ownerless
// design. embedding is Unsupported for the same reason as Posting.embedding above.
model UserProfile {
  id         String                       @id @default(cuid())
  targetRole String?
  embedding  Unsupported("vector(384)")?
  updatedAt  DateTime                     @updatedAt
}
